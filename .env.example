DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
AUTH_SECRET="replace-with-long-random-secret"
ADMIN_EMAIL="admin@example.com"
N8N_SYNC_SECRET="replace-with-strong-shared-secret"
N8N_WEBHOOK_URL="https://your-n8n-instance/webhook/founder-profile"
N8N_SECRET_KEY="replace-with-webhook-secret"
N8N_COMPANY_CONTENT_WEBHOOK_URL="https://your-n8n-instance/webhook/company-content"
N8N_NEWSLETTER_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/subscribe"
N8N_UNLOCK_CONTACT_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/unlock-contact"
N8N_CLAIM_PROFILE_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/claim-profile"
N8N_INTERVIEW_WEBHOOK_URL="https://your-n8n-instance/webhook/interview-intake"
N8N_GUEST_POST_WEBHOOK_URL="https://your-n8n-instance/webhook/guest-post-order"
N8N_INSTAGRAM_SYNC_WEBHOOK_URL="https://your-n8n-instance/webhook/instagram-sync"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/100x.founder/"
NEXT_PUBLIC_WHATSAPP_NUMBER="917988253046"
NEXT_PUBLIC_WHATSAPP_FEATURED_TEXT="I want to get featured on 100xfounder.com"
ALLOW_USER_SUBMITTED_DOFOLLOW_LINKS="false"

# Optional demo admin login for local/dev admin dashboard access.
# Enabled by default in non-production if DUMMY_ADMIN_ENABLED is not set.
DUMMY_ADMIN_ENABLED="true"
DUMMY_ADMIN_EMAIL="admin@100xfounder.com"
DUMMY_ADMIN_PASSWORD="Admin@12345"
DUMMY_ADMIN_NAME="100Xfounder Admin"

# --- Daily growth routine: Product Hunt import + founder outreach ---
# Developer token from https://www.producthunt.com/v2/oauth/applications
PRODUCT_HUNT_TOKEN=
PH_TOP_N=10
PH_TOP_FEATURED_RANK=5
PH_VOTE_THRESHOLD=100
# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Outreach email (use a dedicated mailbox, e.g. a Google Workspace user with an app password)
OUTREACH_ENABLED=false
OUTREACH_DAILY_LIMIT=30
# Days to wait after the previous email (defaults give day 0 / day 3 / day 7)
OUTREACH_FOLLOWUP_1_DAYS=3
OUTREACH_FOLLOWUP_2_DAYS=4
OUTREACH_FROM_NAME=
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=
# Required by CAN-SPAM; sending stays off until this is set
OUTREACH_POSTAL_ADDRESS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Reply and bounce detection (defaults to the SMTP credentials)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Publish founder spotlights without manual review
SPOTLIGHT_AUTO_PUBLISH=false

# --- Headless WordPress (blog + pages) ---
WORDPRESS_URL=
WORDPRESS_REVALIDATE_SECRET=
